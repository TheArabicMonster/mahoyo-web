{
  "name": "mahoyo-web",
  "version": "0.1.0",
  "description": "Port web de Mahoutsukai no Yoru (Mahoyo) — projet réel",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit src",
    "test:integration": "vitest run tests/integration",
    "test:full-read": "vitest run tests/integration/full-read.test.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint src tools tests *.config.ts eslint.config.js",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\"",
    "pipeline": "tsx tools/pipeline.ts",
    "normalize-ks": "tsx tools/normalize-ks.ts",
    "extract-xp3": "tsx tools/extract-xp3.ts",
    "convert-tlg": "tsx tools/convert-tlg.ts",
    "convert-audio": "tsx tools/convert-audio.ts",
    "audit": "tsx tools/audit-scenario.ts",
    "translation": "tsx tools/translation.ts",
    "progress": "tsx tools/progress.ts",
    "check:assets": "tsx tools/check-no-assets.ts",
    "chain": "tsx tools/story-chain.ts",
    "timelines": "tsx tools/timelines.ts",
    "trace:visual": "tsx tools/trace-visual.ts",
    "lint:fix": "eslint src tools tests *.config.ts eslint.config.js --fix"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^14.0.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  }
}
